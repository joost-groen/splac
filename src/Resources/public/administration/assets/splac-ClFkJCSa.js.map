<sw-page class="splac-wizard">
    <template #smart-bar-header>
        <h2>{{ $tc('splac.wizard.title') }}</h2>
    </template>

    <template #content>
        <sw-card-view>
            <div class="splac-wizard__steps">
                <div
                    v-for="n in 3"
                    :key="n"
                    class="splac-wizard__step-indicator"
                    :class="{ 'is--active': step === n, 'is--done': step > n }"
                >
                    <span class="splac-wizard__step-number">{{ n }}</span>
                    <span class="splac-wizard__step-label">{{ $tc(`splac.wizard.step${n}Label`) }}</span>
                </div>
            </div>

            <!-- Step 1: template selection -->
            <sw-card
                v-if="step === 1"
                position-identifier="splac-wizard-template"
                :title="$tc('splac.wizard.step1Title')"
            >
                <sw-empty-state
                    v-if="!templates.length"
                    :title="$tc('splac.wizard.noTemplatesTitle')"
                    :subline="$tc('splac.wizard.noTemplatesSubline')"
                    :absolute="false"
                ></sw-empty-state>

                <div v-else class="splac-wizard__template-grid">
                    <button
                        v-for="tpl in templates"
                        :key="tpl.id"
                        type="button"
                        class="splac-wizard__template-card"
                        :class="{ 'is--selected': selectedTemplateId === tpl.id }"
                        @click="selectTemplate(tpl.id)"
                    >
                        <sw-icon name="regular-file-text" size="24px"></sw-icon>
                        <strong>{{ tpl.name }}</strong>
                    </button>
                </div>

                <div v-if="selectedTemplate" class="splac-wizard__language-selection">
                    <sw-select-field
                        v-model="input.language"
                        :label="$tc('splac.wizard.fieldLanguage')"
                        :help-text="$tc('splac.wizard.fieldLanguageHelp')"
                        :options="languageOptions"
                        required
                    ></sw-select-field>
                </div>

                <div class="splac-wizard__actions">
                    <sw-button variant="primary" :disabled="!canGoToStep2" @click="step = 2">
                        {{ $tc('splac.wizard.next') }}
                    </sw-button>
                </div>
            </sw-card>

            <!-- Step 2: sources -->
            <sw-card
                v-if="step === 2"
                position-identifier="splac-wizard-sources"
                :title="$tc('splac.wizard.step2Title')"
            >
                <p class="splac-wizard__hint">{{ $tc('splac.wizard.sourcesHint') }}</p>

                <div
                    class="splac-wizard__dropzone"
                    :class="{ 'is--dragging': isDragging }"
                    @dragover.prevent="isDragging = true"
                    @dragleave.prevent="isDragging = false"
                    @drop="onDrop"
                    @click="$refs.fileInput.click()"
                >
                    <sw-icon name="regular-cloud-upload" size="32px"></sw-icon>
                    <p>{{ $tc('splac.wizard.dropzoneText') }}</p>
                    <input
                        ref="fileInput"
                        type="file"
                        accept="application/pdf"
                        multiple
                        class="splac-wizard__file-input"
                        @change="onFileInputChange"
                    >
                </div>

                <ul v-if="files.length" class="splac-wizard__file-list">
                    <li v-for="(file, index) in files" :key="`${file.name}-${index}`">
                        <sw-icon name="regular-file-text" small></sw-icon>
                        <span>{{ file.name }}</span>
                        <sw-button size="x-small" square @click="removeFile(index)">
                            <sw-icon name="regular-times-s" small></sw-icon>
                        </sw-button>
                    </li>
                </ul>

                <sw-textarea-field
                    v-model="input.notes"
                    :label="$tc('splac.wizard.fieldNotes')"
                    :help-text="$tc('splac.wizard.fieldNotesHelp')"
                ></sw-textarea-field>

                <div class="splac-wizard__actions">
                    <sw-button @click="step = 1">{{ $tc('splac.wizard.back') }}</sw-button>
                    <sw-button variant="primary" :disabled="!canGoToStep3" @click="step = 3">
                        {{ $tc('splac.wizard.next') }}
                    </sw-button>
                </div>
            </sw-card>

            <!-- Step 3: basics -->
            <template v-if="step === 3">
                <sw-card
                    position-identifier="splac-wizard-basics"
                    :title="$tc('splac.wizard.step3Title')"
                >
                    <sw-text-field
                        v-model:value="input.productName"
                        :label="$tc('splac.wizard.fieldProductName')"
                        :help-text="$tc('splac.wizard.fieldProductNameHelp')"
                        required
                    ></sw-text-field>

                    <sw-container columns="1fr 1fr 1fr" gap="0 24px">
                        <sw-number-field
                            v-model:value="input.price"
                            :label="$tc('splac.wizard.fieldPrice')"
                            :digits="2"
                            :min="0"
                        ></sw-number-field>

                        <sw-entity-single-select
                            v-model:value="input.taxId"
                            entity="tax"
                            :label="$tc('splac.wizard.fieldTax')"
                        ></sw-entity-single-select>

                        <sw-number-field
                            v-model:value="input.stock"
                            :label="$tc('splac.wizard.fieldStock')"
                            :digits="0"
                            :min="0"
                        ></sw-number-field>
                    </sw-container>

                    <sw-entity-multi-id-select
                        v-model:value="input.salesChannelIds"
                        :repository="salesChannelRepository"
                        :label="$tc('splac.wizard.fieldSalesChannels')"
                    ></sw-entity-multi-id-select>

                    <sw-select-field
                        v-model="input.categoryMode"
                        :label="$tc('splac.wizard.fieldCategoryMode')"
                        :options="categoryModeOptions"
                    ></sw-select-field>

                    <sw-entity-single-select
                        v-if="input.categoryMode === 'existing'"
                        v-model:value="input.categoryId"
                        entity="category"
                        :label="$tc('splac.wizard.fieldCategory')"
                    ></sw-entity-single-select>

                    <sw-entity-single-select
                        v-else
                        v-model:value="categoryTemplateId"
                        entity="splac_category_template"
                        :label="$tc('splac.wizard.fieldCategoryTemplate')"
                        :help-text="$tc('splac.wizard.fieldCategoryTemplateHelp')"
                    ></sw-entity-single-select>
                </sw-card>

                <sw-card
                    v-if="features.advancedPricing"
                    position-identifier="splac-wizard-advanced-pricing"
                    :title="$tc('splac.wizard.cardAdvancedPricing')"
                >
                    <div
                        v-for="(row, index) in input.advancedPrices"
                        :key="index"
                        class="splac-wizard__advanced-price-row"
                    >
                        <sw-entity-single-select
                            v-model:value="row.ruleId"
                            entity="rule"
                            :label="$tc('splac.wizard.fieldRule')"
                        ></sw-entity-single-select>
                        <sw-number-field
                            v-model:value="row.price"
                            :label="$tc('splac.wizard.fieldPrice')"
                            :digits="2"
                            :min="0"
                        ></sw-number-field>
                        <sw-number-field
                            v-model:value="row.quantityStart"
                            :label="$tc('splac.wizard.fieldQuantityStart')"
                            :digits="0"
                            :min="1"
                        ></sw-number-field>
                        <sw-number-field
                            v-model:value="row.quantityEnd"
                            :label="$tc('splac.wizard.fieldQuantityEnd')"
                            :digits="0"
                            :min="0"
                        ></sw-number-field>
                        <sw-button size="x-small" square @click="removeAdvancedPrice(index)">
                            <sw-icon name="regular-times-s" small></sw-icon>
                        </sw-button>
                    </div>

                    <sw-button size="small" @click="addAdvancedPrice">
                        {{ $tc('splac.wizard.addAdvancedPrice') }}
                    </sw-button>
                </sw-card>

                <sw-card
                    position-identifier="splac-wizard-ai-processing"
                    :title="$tc('splac.wizard.cardAiProcessing')"
                >
                    <p class="splac-wizard__processing-intro">
                        {{ $tc('splac.wizard.aiProcessingHint') }}
                    </p>

                    <div class="splac-wizard__processing-grid">
                        <section
                            class="splac-wizard__processing-option"
                            :class="{
                                'is--active': input.reasoningEnabled,
                                'is--unavailable': !llmCapabilities.reasoning
                            }"
                        >
                            <div class="splac-wizard__processing-option-header">
                                <span class="splac-wizard__processing-icon">
                                    <sw-icon name="regular-lightbulb" size="22px"></sw-icon>
                                </span>
                                <div class="splac-wizard__processing-option-title">
                                    <h3>{{ $tc('splac.wizard.reasoningTitle') }}</h3>
                                    <span>{{ $tc('splac.wizard.qualityControl') }}</span>
                                </div>
                                <sw-switch-field
                                    v-model:value="input.reasoningEnabled"
                                    :disabled="!llmCapabilities.reasoning"
                                    :label="$tc('splac.wizard.reasoningToggle')"
                                ></sw-switch-field>
                            </div>

                            <p>{{ $tc('splac.wizard.reasoningHelp') }}</p>

                            <div
                                v-if="llmCapabilities.reasoning && input.reasoningEnabled"
                                class="splac-wizard__reasoning-level"
                            >
                                <span>{{ $tc('splac.wizard.reasoningLevel') }}</span>
                                <div class="splac-wizard__segmented-control">
                                    <button
                                        v-for="option in reasoningLevelOptions"
                                        :key="option.value"
                                        type="button"
                                        :class="{ 'is--selected': input.reasoningLevel === option.value }"
                                        @click="input.reasoningLevel = option.value"
                                    >
                                        {{ option.label }}
                                    </button>
                                </div>
                            </div>

                            <div v-else-if="!llmCapabilities.reasoning" class="splac-wizard__provider-notice">
                                {{ $tc('splac.wizard.providerUnsupported', 0, { provider: providerLabel }) }}
                            </div>
                        </section>

                        <section
                            class="splac-wizard__processing-option"
                            :class="{
                                'is--active': input.batchProcessing,
                                'is--unavailable': !llmCapabilities.batchProcessing
                            }"
                        >
                            <div class="splac-wizard__processing-option-header">
                                <span class="splac-wizard__processing-icon">
                                    <sw-icon name="regular-clock" size="22px"></sw-icon>
                                </span>
                                <div class="splac-wizard__processing-option-title">
                                    <h3>{{ $tc('splac.wizard.batchTitle') }}</h3>
                                    <span>{{ $tc('splac.wizard.costControl') }}</span>
                                </div>
                                <sw-switch-field
                                    v-model:value="input.batchProcessing"
                                    :disabled="!llmCapabilities.batchProcessing"
                                    :label="$tc('splac.wizard.batchToggle')"
                                ></sw-switch-field>
                            </div>

                            <p>{{ $tc('splac.wizard.batchHelp') }}</p>

                            <div v-if="llmCapabilities.batchProcessing" class="splac-wizard__batch-note">
                                <sw-icon name="regular-info-circle" size="14px"></sw-icon>
                                {{ $tc('splac.wizard.batchTiming') }}
                            </div>

                            <div v-else class="splac-wizard__provider-notice">
                                {{ $tc('splac.wizard.providerUnsupported', 0, { provider: providerLabel }) }}
                            </div>
                        </section>
                    </div>
                </sw-card>

                <sw-card
                    position-identifier="splac-wizard-instructions"
                    :title="$tc('splac.wizard.cardInstructions')"
                >
                    <sw-textarea-field
                        v-if="features.description !== false"
                        v-model="input.descriptionInstruction"
                        :label="$tc('splac.wizard.fieldDescriptionInstruction')"
                    ></sw-textarea-field>

                    <sw-textarea-field
                        v-if="features.seo !== false"
                        v-model="input.seoInstruction"
                        :label="$tc('splac.wizard.fieldSeoInstruction')"
                    ></sw-textarea-field>

                    <div class="splac-wizard__actions">
                        <sw-button @click="step = 2">{{ $tc('splac.wizard.back') }}</sw-button>
                        <sw-button-process
                            variant="primary"
                            :is-loading="isStarting"
                            :process-success="false"
                            :disabled="!canStart"
                            @click="onStart"
                        >
                            {{ $tc('splac.wizard.startButton') }}
                        </sw-button-process>
                    </div>
                </sw-card>
            </template>
        </sw-card-view>
    </template>
</sw-page>

<sw-page class="splac-dashboard">
    <template #smart-bar-header>
        <h2>{{ $tc('splac.dashboard.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button
            variant="ghost"
            size="small"
            @click="showStatistics = true"
        >
            {{ $tc('splac.dashboard.statisticsButton') }}
        </sw-button>
        <sw-button
            variant="ghost"
            size="small"
            @click="$router.push({ name: 'splac.templates' })"
        >
            {{ $tc('splac.general.menuTemplates') }}
        </sw-button>
        <sw-button
            variant="primary"
            size="small"
            @click="$router.push({ name: 'splac.wizard' })"
        >
            {{ $tc('splac.dashboard.newListing') }}
        </sw-button>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card
                position-identifier="splac-dashboard-processes"
                :title="$tc('splac.dashboard.processesTitle')"
                :is-loading="isLoading && !processes"
            >
                <template v-if="processes && processes.length">
                    <sw-data-grid
                        :data-source="processes"
                        :columns="columns"
                        :show-selection="false"
                        :show-actions="true"
                        identifier="splac-process-grid"
                    >
                        <template #column-name="{ item }">
                            <a class="splac-dashboard__process-link" @click="openProcess(item)">
                                {{ item.name }}
                            </a>
                        </template>

                        <template #column-status="{ item }">
                            <div class="splac-dashboard__status-cell">
                                <span class="splac-dashboard__status" :class="`splac-dashboard__status--${item.status}`">
                                    <sw-color-badge :variant="statusVariant(item.status)" rounded></sw-color-badge>
                                    {{ statusLabel(item.status) }}
                                    <template v-if="item.currentStep && ['extracting', 'generating'].includes(item.status)">
                                        – {{ $tc(`splac.steps.${item.currentStep}`) }}
                                    </template>
                                </span>
                                <div
                                    v-if="item.status === 'failed' && item.errorMessage"
                                    class="splac-dashboard__error-message"
                                    :title="item.errorMessage"
                                >
                                    {{ item.errorMessage }}
                                </div>
                            </div>
                        </template>

                        <template #column-createdAt="{ item }">
                            {{ new Date(item.createdAt).toLocaleString() }}
                        </template>

                        <template #column-llmCost="{ item }">
                            {{ formatCost(item.llmCost, item.llmCostCurrency) }}
                        </template>

                        <template #actions="{ item }">
                            <sw-context-menu-item @click="openProcess(item)">
                                {{ item.status === 'review' ? $tc('splac.dashboard.actionReview') : $tc('splac.dashboard.actionOpen') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item
                                v-if="canRetry(item)"
                                @click="onRetry(item)"
                            >
                                {{ $tc('splac.dashboard.actionRetry') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item
                                v-if="canCancel(item)"
                                @click="onCancel(item)"
                            >
                                {{ $tc('splac.dashboard.actionCancel') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item variant="danger" @click="onDelete(item)">
                                {{ $tc('global.default.delete') }}
                            </sw-context-menu-item>
                        </template>

                        <template #pagination>
                            <sw-pagination
                                :page="page"
                                :limit="limit"
                                :total="total"
                                :auto-hide="true"
                                @page-change="onPageChange"
                            ></sw-pagination>
                        </template>
                    </sw-data-grid>
                </template>

                <sw-empty-state
                    v-else-if="!isLoading"
                    :title="$tc('splac.dashboard.emptyTitle')"
                    :subline="$tc('splac.dashboard.emptySubline')"
                    :absolute="false"
                >
                    <template #actions>
                        <sw-button variant="primary" @click="$router.push({ name: 'splac.wizard' })">
                            {{ $tc('splac.dashboard.newListing') }}
                        </sw-button>
                    </template>
                </sw-empty-state>
            </sw-card>
        </sw-card-view>

        <sw-modal
            v-if="showStatistics"
            class="splac-dashboard__statistics-modal"
            :title="$tc('splac.dashboard.statisticsTitle')"
            @modal-close="showStatistics = false"
        >
        <div v-if="isLoading && !statistics" class="splac-dashboard__statistics-loading">
            <sw-loader size="32px"></sw-loader>
        </div>

        <div v-else class="splac-dashboard__statistics">
            <div class="splac-dashboard__statistics-heading">
                <span class="splac-dashboard__statistics-eyebrow">
                    {{ $tc('splac.dashboard.statisticsEyebrow') }}
                </span>
                <h3>{{ $tc('splac.dashboard.statisticsOverviewTitle') }}</h3>
                <p>{{ $tc('splac.dashboard.statisticsOverviewHelp') }}</p>
            </div>

            <div class="splac-dashboard__metric-grid">
                <div class="splac-dashboard__metric">
                    <span class="splac-dashboard__metric-label">
                        {{ $tc('splac.dashboard.totalCompleted') }}
                    </span>
                    <strong>{{ formatNumber(statistics ? statistics.totalCompleted : 0) }}</strong>
                    <small>{{ $tc('splac.dashboard.totalCompletedHelp') }}</small>
                </div>
                <div class="splac-dashboard__metric">
                    <span class="splac-dashboard__metric-label">
                        {{ $tc('splac.dashboard.startedLast30Days') }}
                    </span>
                    <strong>{{ formatNumber(statistics ? statistics.startedLast30Days : 0) }}</strong>
                    <small>{{ $tc('splac.dashboard.startedLast30DaysHelp') }}</small>
                </div>
                <div class="splac-dashboard__metric">
                    <span class="splac-dashboard__metric-label">
                        {{ $tc('splac.dashboard.successRate') }}
                    </span>
                    <strong>{{ formatPercentage(statistics ? statistics.successRate : 0) }}</strong>
                    <small>{{ $tc('splac.dashboard.successRateHelp') }}</small>
                </div>
                <div class="splac-dashboard__metric">
                    <span class="splac-dashboard__metric-label">
                        {{ $tc('splac.dashboard.activeProcesses') }}
                    </span>
                    <strong>{{ formatNumber(statistics ? statistics.activeProcesses : 0) }}</strong>
                    <small>{{ $tc('splac.dashboard.activeProcessesHelp') }}</small>
                </div>
            </div>

            <div class="splac-dashboard__spend">
                <div class="splac-dashboard__section-heading">
                    <div>
                        <h4>{{ $tc('splac.dashboard.costsTitle') }}</h4>
                        <p>{{ $tc('splac.dashboard.costsHelp') }}</p>
                    </div>
                    <span class="splac-dashboard__currency">
                        {{ statistics ? statistics.currency : '—' }}
                    </span>
                </div>

                <div class="splac-dashboard__spend-grid">
                    <div class="splac-dashboard__spend-item">
                        <span>{{ $tc('splac.dashboard.costLast24Hours') }}</span>
                        <strong>{{ formatCost(statistics ? statistics.last24Hours : 0) }}</strong>
                    </div>
                    <div class="splac-dashboard__spend-item">
                        <span>{{ $tc('splac.dashboard.costLast30Days') }}</span>
                        <strong>{{ formatCost(statistics ? statistics.last30Days : 0) }}</strong>
                    </div>
                    <div class="splac-dashboard__spend-item">
                        <span>{{ $tc('splac.dashboard.costAllTime') }}</span>
                        <strong>{{ formatCost(statistics ? statistics.allTime : 0) }}</strong>
                    </div>
                </div>
            </div>

            <div class="splac-dashboard__efficiency">
                <div>
                    <span>{{ $tc('splac.dashboard.averageCost') }}</span>
                    <small>{{ $tc('splac.dashboard.averageCostHelp') }}</small>
                </div>
                <strong>{{ formatCost(statistics ? statistics.averageCostPerCompleted : 0) }}</strong>
            </div>
        </div>

        <template #modal-footer>
            <sw-button size="small" @click="showStatistics = false">
                {{ $tc('global.default.close') }}
            </sw-button>
        </template>
        </sw-modal>
    </template>
</sw-page>

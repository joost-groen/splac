<sw-page class="splac-template-detail">
    <template #smart-bar-header>
        <h2>{{ item && item.name ? item.name : $tc('splac.templateDetail.titleNew') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button size="small" @click="$router.push({ name: 'splac.templates' })">
            {{ $tc('global.default.cancel') }}
        </sw-button>
        <sw-button-process
            variant="primary"
            size="small"
            :is-loading="isSaving"
            :process-success="false"
            @click="onSave"
        >
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view v-if="item">
            <sw-card
                position-identifier="splac-template-detail-general"
                :title="$tc('splac.templateDetail.cardGeneral')"
                :is-loading="isLoading"
            >
                <sw-text-field
                    v-model:value="item.name"
                    :label="$tc('splac.templateDetail.fieldName')"
                    :placeholder="$tc('splac.templateDetail.fieldNamePlaceholder')"
                    required
                ></sw-text-field>

                <sw-switch-field
                    v-model:value="item.active"
                    :label="$tc('splac.templateDetail.fieldActive')"
                ></sw-switch-field>

                <sw-text-field
                    v-model:value="item.config.productNumberPattern"
                    :label="$tc('splac.templateDetail.fieldProductNumberPattern')"
                    :help-text="$tc('splac.templateDetail.fieldProductNumberPatternHelp')"
                    placeholder="LAP-{model}"
                ></sw-text-field>

                <sw-entity-single-select
                    v-model:value="item.config.defaultTaxId"
                    entity="tax"
                    :label="$tc('splac.templateDetail.fieldDefaultTax')"
                ></sw-entity-single-select>

                <sw-entity-multi-id-select
                    v-model:value="item.config.defaultSalesChannelIds"
                    :repository="repositoryFactory.create('sales_channel')"
                    :label="$tc('splac.templateDetail.fieldDefaultSalesChannels')"
                ></sw-entity-multi-id-select>
            </sw-card>

            <sw-card
                position-identifier="splac-template-detail-features"
                :title="$tc('splac.templateDetail.cardFeatures')"
                :is-loading="isLoading"
            >
                <div class="splac-template-detail__features">
                    <sw-switch-field
                        v-for="feature in featureList"
                        :key="feature"
                        v-model:value="item.config.features[feature]"
                        :label="$tc(`splac.templateDetail.feature.${feature}`)"
                    ></sw-switch-field>
                </div>
            </sw-card>

            <sw-card
                position-identifier="splac-template-detail-ai-guidance"
                :title="$tc('splac.templateDetail.cardAiGuidance')"
                :is-loading="isLoading"
            >
                <p class="splac-template-detail__hint">
                    {{ $tc('splac.templateDetail.aiGuidanceHint') }}
                </p>

                <sw-textarea-field
                    v-model="item.config.targetMarket"
                    :label="$tc('splac.templateDetail.fieldTargetMarket')"
                    :placeholder="$tc('splac.templateDetail.fieldTargetMarketPlaceholder')"
                    :help-text="$tc('splac.templateDetail.fieldTargetMarketHelp')"
                ></sw-textarea-field>
            </sw-card>

            <sw-card
                position-identifier="splac-template-detail-description"
                :title="$tc('splac.templateDetail.cardDescription')"
                :is-loading="isLoading"
            >
                <p class="splac-template-detail__hint">
                    {{ $tc('splac.templateDetail.descriptionHint') }}
                </p>

                <div class="splac-template-detail__locale-tabs">
                    <button
                        v-for="locale in locales"
                        :key="locale"
                        type="button"
                        class="splac-template-detail__locale-tab"
                        :class="{ 'is--active': activeDescriptionLocale === locale }"
                        @click="activeDescriptionLocale = locale"
                    >
                        {{ locale }}
                    </button>
                </div>

                <section class="splac-template-detail__layout-panel">
                    <header class="splac-template-detail__layout-panel-header">
                        <strong>{{ $tc('splac.templateDetail.descriptionFormattingTitle') }}</strong>
                        <span>{{ $tc('splac.templateDetail.descriptionFormattingHelp') }}</span>
                    </header>

                    <div class="splac-template-detail__layout-options">
                        <article
                            class="splac-template-detail__layout-option"
                            :class="{ 'is--active': item.config.descriptionStyle.blockSpacingEnabled }"
                        >
                            <div class="splac-template-detail__layout-option-header">
                                <div class="splac-template-detail__layout-copy">
                                    <strong>{{ $tc('splac.templateDetail.blockSpacingTitle') }}</strong>
                                    <span>{{ $tc('splac.templateDetail.blockSpacingHelp') }}</span>
                                </div>
                                <button
                                    type="button"
                                    class="splac-template-detail__setting-toggle"
                                    :class="{ 'is--active': item.config.descriptionStyle.blockSpacingEnabled }"
                                    :aria-label="$tc('splac.templateDetail.blockSpacingToggle')"
                                    :aria-pressed="item.config.descriptionStyle.blockSpacingEnabled"
                                    @click="item.config.descriptionStyle.blockSpacingEnabled = !item.config.descriptionStyle.blockSpacingEnabled"
                                >
                                    <span class="splac-template-detail__setting-toggle-track" aria-hidden="true">
                                        <span class="splac-template-detail__setting-toggle-thumb"></span>
                                    </span>
                                    <span>
                                        {{
                                            item.config.descriptionStyle.blockSpacingEnabled
                                                ? $tc('splac.templateDetail.toggleEnabled')
                                                : $tc('splac.templateDetail.toggleDisabled')
                                        }}
                                    </span>
                                </button>
                            </div>
                            <div
                                v-if="item.config.descriptionStyle.blockSpacingEnabled"
                                class="splac-template-detail__layout-control"
                            >
                                <div class="splac-template-detail__spacing-presets">
                                    <button
                                        type="button"
                                        :class="{ 'is--active': item.config.descriptionStyle.blockSpacing === 8 }"
                                        @click="item.config.descriptionStyle.blockSpacing = 8"
                                    >
                                        {{ $tc('splac.templateDetail.spacingCompact') }}
                                    </button>
                                    <button
                                        type="button"
                                        :class="{ 'is--active': item.config.descriptionStyle.blockSpacing === 16 }"
                                        @click="item.config.descriptionStyle.blockSpacing = 16"
                                    >
                                        {{ $tc('splac.templateDetail.spacingComfortable') }}
                                    </button>
                                    <button
                                        type="button"
                                        :class="{ 'is--active': item.config.descriptionStyle.blockSpacing === 32 }"
                                        @click="item.config.descriptionStyle.blockSpacing = 32"
                                    >
                                        {{ $tc('splac.templateDetail.spacingSpacious') }}
                                    </button>
                                </div>
                                <label class="splac-template-detail__spacing-exact">
                                    <span>{{ $tc('splac.templateDetail.blockSpacingExact') }}</span>
                                    <span class="splac-template-detail__spacing-input">
                                        <input
                                            v-model.number="item.config.descriptionStyle.blockSpacing"
                                            type="number"
                                            min="0"
                                            max="200"
                                            step="1"
                                        >
                                        <span>px</span>
                                    </span>
                                </label>
                            </div>
                        </article>

                        <article
                            class="splac-template-detail__layout-option"
                            :class="{ 'is--active': item.config.descriptionStyle.tableFormattingEnabled }"
                        >
                            <div class="splac-template-detail__layout-option-header">
                                <div class="splac-template-detail__layout-copy">
                                    <strong>{{ $tc('splac.templateDetail.tableFormattingToggleTitle') }}</strong>
                                    <span>{{ $tc('splac.templateDetail.tableFormattingToggleHelp') }}</span>
                                </div>
                                <button
                                    type="button"
                                    class="splac-template-detail__setting-toggle"
                                    :class="{ 'is--active': item.config.descriptionStyle.tableFormattingEnabled }"
                                    :aria-label="$tc('splac.templateDetail.tableFormattingToggle')"
                                    :aria-pressed="item.config.descriptionStyle.tableFormattingEnabled"
                                    @click="item.config.descriptionStyle.tableFormattingEnabled = !item.config.descriptionStyle.tableFormattingEnabled"
                                >
                                    <span class="splac-template-detail__setting-toggle-track" aria-hidden="true">
                                        <span class="splac-template-detail__setting-toggle-thumb"></span>
                                    </span>
                                    <span>
                                        {{
                                            item.config.descriptionStyle.tableFormattingEnabled
                                                ? $tc('splac.templateDetail.toggleEnabled')
                                                : $tc('splac.templateDetail.toggleDisabled')
                                        }}
                                    </span>
                                </button>
                            </div>
                            <div
                                v-if="item.config.descriptionStyle.tableFormattingEnabled"
                                class="splac-template-detail__layout-status"
                            >
                                <span aria-hidden="true">✓</span>
                                <span>{{ $tc('splac.templateDetail.tableFormattingEnabledHint') }}</span>
                            </div>
                            <button
                                v-if="item.config.descriptionStyle.tableFormattingEnabled"
                                type="button"
                                class="splac-template-detail__global-table-style"
                                :class="{
                                    'is--active': item.config.descriptionStyle.recommendedTableStyleForAllTables
                                }"
                                :aria-pressed="item.config.descriptionStyle.recommendedTableStyleForAllTables"
                                @click="toggleRecommendedTableStyleForAllTables"
                            >
                                <span class="splac-template-detail__global-table-style-icon" aria-hidden="true">
                                    {{
                                        item.config.descriptionStyle.recommendedTableStyleForAllTables
                                            ? '✓'
                                            : '✦'
                                    }}
                                </span>
                                <span class="splac-template-detail__global-table-style-copy">
                                    <strong>{{ $tc('splac.templateDetail.tablePresetApplyAllTitle') }}</strong>
                                    <small>{{ $tc('splac.templateDetail.tablePresetApplyAllHelp') }}</small>
                                </span>
                                <span class="splac-template-detail__global-table-style-action">
                                    {{
                                        item.config.descriptionStyle.recommendedTableStyleForAllTables
                                            ? $tc('splac.templateDetail.tablePresetDefaultActive')
                                            : $tc('splac.templateDetail.tablePresetApplyAll')
                                    }}
                                </span>
                            </button>
                        </article>
                    </div>
                </section>

                <div class="splac-template-detail__block-library">
                    <div>
                        <strong>{{ $tc('splac.templateDetail.addBlock') }}</strong>
                        <span>{{ $tc('splac.templateDetail.addBlockHint') }}</span>
                    </div>
                    <div class="splac-template-detail__block-library-actions">
                        <sw-button size="small" @click="addDescriptionBlock('heading')">
                            + {{ $tc('splac.templateDetail.blockType.heading') }}
                        </sw-button>
                        <sw-button size="small" @click="addDescriptionBlock('paragraph')">
                            + {{ $tc('splac.templateDetail.blockType.paragraph') }}
                        </sw-button>
                        <sw-button size="small" @click="addDescriptionBlock('table')">
                            + {{ $tc('splac.templateDetail.blockType.table') }}
                        </sw-button>
                        <sw-button size="small" @click="addDescriptionBlock('conditional')">
                            + {{ $tc('splac.templateDetail.blockType.conditional') }}
                        </sw-button>
                    </div>
                </div>

                <sw-empty-state
                    v-if="!activeDescriptionBlocks.length"
                    :title="$tc('splac.templateDetail.emptyBlocksTitle')"
                    :subline="$tc('splac.templateDetail.emptyBlocksSubline')"
                    :absolute="false"
                ></sw-empty-state>

                <div v-else class="splac-template-detail__blocks">
                    <section
                        v-for="(block, blockIndex) in activeDescriptionBlocks"
                        :key="block.id"
                        class="splac-template-detail__block"
                    >
                        <header class="splac-template-detail__block-header">
                            <div class="splac-template-detail__block-title">
                                <span class="splac-template-detail__block-order">{{ blockIndex + 1 }}</span>
                                <strong>{{ blockTypeLabel(block.type) }}</strong>
                            </div>
                            <div class="splac-template-detail__block-actions">
                                <sw-button
                                    size="x-small"
                                    square
                                    :disabled="blockIndex === 0"
                                    :title="$tc('splac.templateDetail.moveBlockUp')"
                                    @click="moveDescriptionBlock(blockIndex, -1)"
                                >↑</sw-button>
                                <sw-button
                                    size="x-small"
                                    square
                                    :disabled="blockIndex === activeDescriptionBlocks.length - 1"
                                    :title="$tc('splac.templateDetail.moveBlockDown')"
                                    @click="moveDescriptionBlock(blockIndex, 1)"
                                >↓</sw-button>
                                <sw-button
                                    size="x-small"
                                    square
                                    variant="danger"
                                    :title="$tc('global.default.delete')"
                                    @click="removeDescriptionBlock(blockIndex)"
                                >×</sw-button>
                            </div>
                        </header>

                        <div class="splac-template-detail__block-body">
                            <div v-if="block.type === 'heading'">
                                <sw-select-field
                                    v-model="block.level"
                                    :label="$tc('splac.templateDetail.headingLevel')"
                                    :options="headingLevelOptions"
                                ></sw-select-field>
                                <sw-select-field
                                    v-model="block.contentMode"
                                    :label="$tc('splac.templateDetail.blockContentMode')"
                                    :options="blockContentModeOptions"
                                ></sw-select-field>
                                <sw-textarea-field
                                    v-if="block.contentMode === 'generated'"
                                    v-model="block.instruction"
                                    :label="$tc('splac.templateDetail.blockInstruction')"
                                    :placeholder="$tc('splac.templateDetail.headingInstructionPlaceholder')"
                                    :help-text="$tc('splac.templateDetail.blockInstructionHelp')"
                                ></sw-textarea-field>
                                <sw-text-field
                                    v-else
                                    v-model:value="block.content"
                                    :label="$tc('splac.templateDetail.headingText')"
                                    :help-text="block.contentMode === 'placeholder'
                                        ? $tc('splac.templateDetail.inlinePlaceholderHelp')
                                        : $tc('splac.templateDetail.staticTextHelp')"
                                ></sw-text-field>
                                <sw-button
                                    v-if="block.contentMode === 'placeholder'"
                                    size="small"
                                    @click="insertBlockPlaceholder(block)"
                                >
                                    + {{ $tc('splac.templateDetail.insertPlaceholder') }}
                                </sw-button>
                            </div>

                            <div
                                v-else-if="block.type === 'paragraph'"
                            >
                                <div class="splac-template-detail__optional-heading">
                                    <sw-text-field
                                        v-model:value="block.heading"
                                        :label="$tc('splac.templateDetail.optionalHeading')"
                                        :placeholder="$tc('splac.templateDetail.optionalHeadingPlaceholder')"
                                        :help-text="$tc('splac.templateDetail.optionalHeadingHelp')"
                                    ></sw-text-field>
                                    <sw-select-field
                                        v-if="block.heading"
                                        v-model="block.headingLevel"
                                        :label="$tc('splac.templateDetail.headingLevel')"
                                        :options="headingLevelOptions"
                                    ></sw-select-field>
                                </div>
                                <sw-select-field
                                    v-model="block.contentMode"
                                    :label="$tc('splac.templateDetail.blockContentMode')"
                                    :options="blockContentModeOptions"
                                ></sw-select-field>
                                <sw-textarea-field
                                    v-if="block.contentMode === 'generated'"
                                    v-model="block.instruction"
                                    :label="$tc('splac.templateDetail.blockInstruction')"
                                    :placeholder="$tc('splac.templateDetail.paragraphInstructionPlaceholder')"
                                    :help-text="$tc('splac.templateDetail.blockInstructionHelp')"
                                ></sw-textarea-field>
                                <sw-text-editor
                                    v-else
                                    :value="richTextEditorValue(block)"
                                    :label="$tc('splac.templateDetail.paragraphText')"
                                    sanitize-input
                                    sanitize-field-name="product_translation.description"
                                    @update:value="updateRichText(block, $event)"
                                ></sw-text-editor>
                                <p
                                    v-if="block.contentMode !== 'generated'"
                                    class="splac-template-detail__rich-text-help"
                                >
                                    {{
                                        block.contentMode === 'placeholder'
                                            ? $tc('splac.templateDetail.inlinePlaceholderHelp')
                                            : $tc('splac.templateDetail.richTextHelp')
                                    }}
                                </p>
                                <div
                                    v-if="block.contentMode !== 'generated'"
                                    class="splac-template-detail__rich-text-actions"
                                >
                                    <sw-button
                                        v-if="block.contentMode === 'placeholder'"
                                        size="small"
                                        @click="insertBlockPlaceholder(block)"
                                    >
                                        + {{ $tc('splac.templateDetail.insertPlaceholder') }}
                                    </sw-button>
                                    <sw-button size="small" @click="openImageEditor(block)">
                                        + {{ $tc('splac.templateDetail.insertImage') }}
                                    </sw-button>
                                </div>
                            </div>

                            <div v-else-if="block.type === 'table'">
                                <sw-text-field
                                    v-model:value="block.title"
                                    :label="$tc('splac.templateDetail.tableTitle')"
                                    :placeholder="$tc('splac.templateDetail.tableTitlePlaceholder')"
                                ></sw-text-field>

                                <section
                                    v-if="item.config.descriptionStyle.tableFormattingEnabled"
                                    class="splac-template-detail__format-preset"
                                >
                                    <header>
                                        <strong>{{ $tc('splac.templateDetail.tablePresetTitle') }}</strong>
                                        <span>{{ $tc('splac.templateDetail.tablePresetHelp') }}</span>
                                    </header>
                                    <button
                                        type="button"
                                        class="splac-template-detail__preset-card"
                                        :class="{ 'is--active': isRecommendedTableStyle(block) }"
                                        :aria-pressed="isRecommendedTableStyle(block)"
                                        @click="applyRecommendedTableStyle(block)"
                                    >
                                        <span class="splac-template-detail__preset-copy">
                                            <span class="splac-template-detail__preset-heading">
                                                <strong>{{ $tc('splac.templateDetail.tablePresetRecommendedName') }}</strong>
                                                <small>{{ $tc('splac.templateDetail.tablePresetRecommendedBadge') }}</small>
                                            </span>
                                            <span class="splac-template-detail__preset-description">
                                                {{ $tc('splac.templateDetail.tablePresetRecommendedHelp') }}
                                            </span>
                                            <span class="splac-template-detail__preset-properties">
                                                <small>34 / 66</small>
                                                <small>12 × 16 px</small>
                                                <small>{{ $tc('splac.templateDetail.tablePresetSubtleBorders') }}</small>
                                            </span>
                                        </span>
                                        <span class="splac-template-detail__preset-preview" aria-hidden="true">
                                            <span>
                                                <i></i>
                                                <i></i>
                                            </span>
                                            <span>
                                                <i></i>
                                                <i></i>
                                            </span>
                                            <span>
                                                <i></i>
                                                <i></i>
                                            </span>
                                        </span>
                                        <span class="splac-template-detail__preset-action">
                                            {{
                                                isRecommendedTableStyle(block)
                                                    ? $tc('splac.templateDetail.tablePresetApplied')
                                                    : $tc('splac.templateDetail.tablePresetApply')
                                            }}
                                        </span>
                                    </button>
                                </section>

                                <details
                                    v-if="item.config.descriptionStyle.tableFormattingEnabled"
                                    class="splac-template-detail__table-format"
                                >
                                    <summary>
                                        <span>
                                            <strong>{{ $tc('splac.templateDetail.tableFormatting') }}</strong>
                                            <small>{{ $tc('splac.templateDetail.tableFormattingSummary') }}</small>
                                        </span>
                                    </summary>

                                    <div class="splac-template-detail__table-format-body">
                                        <section class="splac-template-detail__format-group">
                                            <header>
                                                <strong>{{ $tc('splac.templateDetail.tableBorders') }}</strong>
                                                <span>{{ $tc('splac.templateDetail.tableBordersHelp') }}</span>
                                            </header>
                                            <div class="splac-template-detail__format-grid splac-template-detail__format-grid--three">
                                                <sw-select-field
                                                    v-model="block.tableStyle.borderStyle"
                                                    :label="$tc('splac.templateDetail.tableBorderStyle')"
                                                    :options="borderStyleOptions"
                                                ></sw-select-field>
                                                <sw-number-field
                                                    v-model:value="block.tableStyle.borderWidth"
                                                    :label="$tc('splac.templateDetail.tableBorderWidth')"
                                                    :disabled="block.tableStyle.borderStyle === 'none'"
                                                    :min="0"
                                                    :max="10"
                                                    :digits="0"
                                                ></sw-number-field>
                                                <label class="splac-template-detail__color-field">
                                                    <span>{{ $tc('splac.templateDetail.tableBorderColor') }}</span>
                                                    <span class="splac-template-detail__color-control">
                                                        <input
                                                            v-model="block.tableStyle.borderColor"
                                                            type="color"
                                                        >
                                                        <code>{{ block.tableStyle.borderColor }}</code>
                                                    </span>
                                                </label>
                                            </div>
                                        </section>

                                        <section class="splac-template-detail__format-group">
                                            <header>
                                                <strong>{{ $tc('splac.templateDetail.tableCellColours') }}</strong>
                                                <span>{{ $tc('splac.templateDetail.tableCellColoursHelp') }}</span>
                                            </header>
                                            <div class="splac-template-detail__format-grid splac-template-detail__format-grid--two">
                                                <label class="splac-template-detail__color-field">
                                                    <span>{{ $tc('splac.templateDetail.tableLabelBackground') }}</span>
                                                    <span class="splac-template-detail__color-control">
                                                        <input
                                                            v-model="block.tableStyle.labelBackgroundColor"
                                                            type="color"
                                                        >
                                                        <code>{{ block.tableStyle.labelBackgroundColor }}</code>
                                                    </span>
                                                </label>
                                                <label class="splac-template-detail__color-field">
                                                    <span>{{ $tc('splac.templateDetail.tableValueBackground') }}</span>
                                                    <span class="splac-template-detail__color-control">
                                                        <input
                                                            v-model="block.tableStyle.valueBackgroundColor"
                                                            type="color"
                                                        >
                                                        <code>{{ block.tableStyle.valueBackgroundColor }}</code>
                                                    </span>
                                                </label>
                                            </div>
                                        </section>

                                        <section class="splac-template-detail__format-group">
                                            <header>
                                                <strong>{{ $tc('splac.templateDetail.tableColumnWidths') }}</strong>
                                                <span>{{ $tc('splac.templateDetail.tableColumnWidthsHelp') }}</span>
                                            </header>
                                            <div class="splac-template-detail__column-layout">
                                                <sw-number-field
                                                    v-model:value="block.tableStyle.leftColumnWidth"
                                                    :label="$tc('splac.templateDetail.tableLeftColumnWidth')"
                                                    :min="10"
                                                    :max="90"
                                                    :digits="0"
                                                ></sw-number-field>
                                                <div class="splac-template-detail__column-ratio-field">
                                                    <span class="splac-template-detail__column-ratio-label">
                                                        {{ $tc('splac.templateDetail.tableColumnPreview') }}
                                                    </span>
                                                    <div class="splac-template-detail__column-ratio">
                                                        <span
                                                            class="splac-template-detail__column-ratio-left"
                                                            :style="{ width: `${block.tableStyle.leftColumnWidth}%` }"
                                                        >
                                                            {{ block.tableStyle.leftColumnWidth }}%
                                                        </span>
                                                        <span
                                                            class="splac-template-detail__column-ratio-right"
                                                            :style="{ width: `${100 - block.tableStyle.leftColumnWidth}%` }"
                                                        >
                                                            {{ 100 - block.tableStyle.leftColumnWidth }}%
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="splac-template-detail__format-group">
                                            <header>
                                                <strong>{{ $tc('splac.templateDetail.tableAlignment') }}</strong>
                                                <span>{{ $tc('splac.templateDetail.tableAlignmentHelp') }}</span>
                                            </header>
                                            <div class="splac-template-detail__format-grid splac-template-detail__format-grid--three">
                                                <sw-select-field
                                                    v-model="block.tableStyle.headerAlignment"
                                                    :label="$tc('splac.templateDetail.tableHeaderAlignment')"
                                                    :options="horizontalAlignmentOptions"
                                                ></sw-select-field>
                                                <sw-select-field
                                                    v-model="block.tableStyle.valueAlignment"
                                                    :label="$tc('splac.templateDetail.tableValueAlignment')"
                                                    :options="horizontalAlignmentOptions"
                                                ></sw-select-field>
                                                <sw-select-field
                                                    v-model="block.tableStyle.verticalAlignment"
                                                    :label="$tc('splac.templateDetail.tableVerticalAlignment')"
                                                    :options="verticalAlignmentOptions"
                                                ></sw-select-field>
                                            </div>
                                        </section>

                                        <section class="splac-template-detail__format-group">
                                            <header>
                                                <strong>{{ $tc('splac.templateDetail.tableSpacing') }}</strong>
                                                <span>{{ $tc('splac.templateDetail.tableSpacingHelp') }}</span>
                                            </header>
                                            <div class="splac-template-detail__format-grid splac-template-detail__format-grid--three">
                                                <sw-number-field
                                                    v-model:value="block.tableStyle.paddingVertical"
                                                    :label="$tc('splac.templateDetail.tablePaddingVertical')"
                                                    :min="0"
                                                    :max="50"
                                                    :digits="0"
                                                ></sw-number-field>
                                                <sw-number-field
                                                    v-model:value="block.tableStyle.paddingHorizontal"
                                                    :label="$tc('splac.templateDetail.tablePaddingHorizontal')"
                                                    :min="0"
                                                    :max="80"
                                                    :digits="0"
                                                ></sw-number-field>
                                                <sw-number-field
                                                    v-model:value="block.tableStyle.cellSpacing"
                                                    :label="$tc('splac.templateDetail.tableCellSpacing')"
                                                    :min="0"
                                                    :max="30"
                                                    :digits="0"
                                                ></sw-number-field>
                                            </div>
                                        </section>

                                        <div class="splac-template-detail__format-footer">
                                            <sw-button size="small" @click="resetTableStyle(block)">
                                                {{ $tc('splac.templateDetail.tableResetFormatting') }}
                                            </sw-button>
                                        </div>
                                    </div>
                                </details>
                                <div
                                    v-else
                                    class="splac-template-detail__table-format-disabled"
                                >
                                    {{ $tc('splac.templateDetail.tableFormattingDisabledHint') }}
                                </div>

                                <div class="splac-template-detail__table-rows">
                                    <div
                                        v-for="(row, rowIndex) in block.rows"
                                        :key="row.id"
                                        class="splac-template-detail__table-row"
                                    >
                                        <span class="splac-template-detail__table-row-number">{{ rowIndex + 1 }}</span>
                                        <sw-text-field
                                            v-model:value="row.label"
                                            :label="$tc('splac.templateDetail.tablePropertyLabel')"
                                            :placeholder="$tc('splac.templateDetail.tablePropertyLabelPlaceholder')"
                                        ></sw-text-field>
                                        <sw-select-field
                                            v-model="row.mode"
                                            :label="$tc('splac.templateDetail.tableValueMode')"
                                            :options="tableValueModeOptions"
                                        ></sw-select-field>
                                        <sw-text-field
                                            v-if="row.mode === 'placeholder'"
                                            v-model:value="row.placeholder"
                                            :label="$tc('splac.templateDetail.tableSourceField')"
                                            :placeholder="$tc('splac.templateDetail.tableSourceFieldPlaceholder')"
                                            :help-text="$tc('splac.templateDetail.tableSourceFieldHelp')"
                                        ></sw-text-field>
                                        <sw-text-field
                                            v-else
                                            v-model:value="row.content"
                                            :label="$tc('splac.templateDetail.tableStaticValue')"
                                        ></sw-text-field>
                                        <div class="splac-template-detail__table-row-actions">
                                            <sw-button
                                                v-if="row.mode === 'placeholder'"
                                                class="splac-template-detail__table-instruction-button"
                                                :class="{ 'is--configured': !!row.instruction }"
                                                size="x-small"
                                                square
                                                variant="ghost"
                                                :title="$tc('splac.templateDetail.tableFieldInstructionButton')"
                                                :aria-label="$tc('splac.templateDetail.tableFieldInstructionButton')"
                                                @click="openTableFieldInstruction(row)"
                                            >✦</sw-button>
                                            <sw-button
                                                size="x-small"
                                                square
                                                variant="danger"
                                                :title="$tc('global.default.delete')"
                                                @click="removeTableRow(block, rowIndex)"
                                            >×</sw-button>
                                        </div>
                                    </div>
                                </div>

                                <sw-button size="small" @click="addTableRow(block)">
                                    + {{ $tc('splac.templateDetail.addTableProperty') }}
                                </sw-button>
                            </div>

                            <div v-else-if="block.type === 'conditional'">
                                <div class="splac-template-detail__condition-config">
                                    <div class="splac-template-detail__condition-heading">
                                        <strong>{{ $tc('splac.templateDetail.conditionTitle') }}</strong>
                                        <span>{{ $tc('splac.templateDetail.conditionHelp') }}</span>
                                    </div>
                                    <div class="splac-template-detail__condition-fields">
                                        <sw-text-field
                                            v-model:value="block.condition.field"
                                            :label="$tc('splac.templateDetail.conditionField')"
                                            :placeholder="$tc('splac.templateDetail.conditionFieldPlaceholder')"
                                            :help-text="$tc('splac.templateDetail.conditionFieldHelp')"
                                        ></sw-text-field>
                                        <sw-select-field
                                            v-model="block.condition.operator"
                                            :label="$tc('splac.templateDetail.conditionOperatorLabel')"
                                            :options="conditionOperatorOptions"
                                        ></sw-select-field>
                                        <sw-text-field
                                            v-if="conditionNeedsValue(block.condition.operator)"
                                            v-model:value="block.condition.value"
                                            :label="$tc('splac.templateDetail.conditionValue')"
                                            :placeholder="$tc('splac.templateDetail.conditionValuePlaceholder')"
                                        ></sw-text-field>
                                    </div>
                                </div>

                                <div class="splac-template-detail__condition-branches">
                                    <section class="splac-template-detail__condition-branch splac-template-detail__condition-branch--then">
                                        <header>
                                            <span>{{ $tc('splac.templateDetail.conditionThenBadge') }}</span>
                                            <strong>{{ $tc('splac.templateDetail.conditionThen') }}</strong>
                                        </header>
                                        <div class="splac-template-detail__optional-heading">
                                            <sw-text-field
                                                v-model:value="block.thenBranch.heading"
                                                :label="$tc('splac.templateDetail.optionalHeading')"
                                                :placeholder="$tc('splac.templateDetail.optionalHeadingPlaceholder')"
                                            ></sw-text-field>
                                            <sw-select-field
                                                v-if="block.thenBranch.heading"
                                                v-model="block.thenBranch.headingLevel"
                                                :label="$tc('splac.templateDetail.headingLevel')"
                                                :options="headingLevelOptions"
                                            ></sw-select-field>
                                        </div>
                                        <sw-text-editor
                                            :value="richTextEditorValue(block.thenBranch)"
                                            :label="$tc('splac.templateDetail.conditionBranchContent')"
                                            sanitize-input
                                            sanitize-field-name="product_translation.description"
                                            @update:value="updateRichText(block.thenBranch, $event)"
                                        ></sw-text-editor>
                                        <div class="splac-template-detail__rich-text-actions">
                                            <sw-button size="small" @click="insertTextPlaceholder(block.thenBranch)">
                                                + {{ $tc('splac.templateDetail.insertPlaceholder') }}
                                            </sw-button>
                                            <sw-button size="small" @click="openImageEditor(block.thenBranch)">
                                                + {{ $tc('splac.templateDetail.insertImage') }}
                                            </sw-button>
                                        </div>
                                    </section>

                                    <section class="splac-template-detail__condition-branch splac-template-detail__condition-branch--else">
                                        <header>
                                            <span>{{ $tc('splac.templateDetail.conditionElseBadge') }}</span>
                                            <strong>{{ $tc('splac.templateDetail.conditionElse') }}</strong>
                                        </header>
                                        <div class="splac-template-detail__optional-heading">
                                            <sw-text-field
                                                v-model:value="block.elseBranch.heading"
                                                :label="$tc('splac.templateDetail.optionalHeading')"
                                                :placeholder="$tc('splac.templateDetail.optionalHeadingPlaceholder')"
                                            ></sw-text-field>
                                            <sw-select-field
                                                v-if="block.elseBranch.heading"
                                                v-model="block.elseBranch.headingLevel"
                                                :label="$tc('splac.templateDetail.headingLevel')"
                                                :options="headingLevelOptions"
                                            ></sw-select-field>
                                        </div>
                                        <sw-text-editor
                                            :value="richTextEditorValue(block.elseBranch)"
                                            :label="$tc('splac.templateDetail.conditionBranchContent')"
                                            sanitize-input
                                            sanitize-field-name="product_translation.description"
                                            @update:value="updateRichText(block.elseBranch, $event)"
                                        ></sw-text-editor>
                                        <div class="splac-template-detail__rich-text-actions">
                                            <sw-button size="small" @click="insertTextPlaceholder(block.elseBranch)">
                                                + {{ $tc('splac.templateDetail.insertPlaceholder') }}
                                            </sw-button>
                                            <sw-button size="small" @click="openImageEditor(block.elseBranch)">
                                                + {{ $tc('splac.templateDetail.insertImage') }}
                                            </sw-button>
                                        </div>
                                    </section>
                                </div>
                            </div>

                            <div v-else>
                                <sw-alert variant="info">
                                    {{ $tc('splac.templateDetail.legacyHtmlHint') }}
                                </sw-alert>
                                <sw-textarea-field
                                    v-model="block.content"
                                    class="splac-template-detail__html-textarea"
                                    :label="$tc('splac.templateDetail.blockType.html')"
                                ></sw-textarea-field>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="splac-template-detail__preview">
                    <div class="splac-template-detail__preview-header">
                        <strong>{{ $tc('splac.templateDetail.preview') }}</strong>
                        <span>{{ activeDescriptionLocale }}</span>
                    </div>
                    <div
                        v-if="renderDescriptionLocale(activeDescriptionLocale)"
                        class="splac-template-detail__preview-content"
                        v-html="renderDescriptionLocale(activeDescriptionLocale)"
                    ></div>
                    <p v-else class="splac-template-detail__preview-empty">
                        {{ $tc('splac.templateDetail.previewEmpty') }}
                    </p>
                </div>

                <sw-modal
                    v-if="imageEditorTarget"
                    :title="$tc('splac.templateDetail.insertImageTitle')"
                    @modal-close="closeImageEditor"
                >
                    <p class="splac-template-detail__image-help">
                        {{ $tc('splac.templateDetail.insertImageHelp') }}
                    </p>
                    <sw-media-field
                        v-model:value="imageMediaId"
                        :label="$tc('splac.templateDetail.imageMedia')"
                        single-select
                    ></sw-media-field>
                    <div class="splac-template-detail__image-divider">
                        <span>{{ $tc('splac.templateDetail.imageOrUrl') }}</span>
                    </div>
                    <sw-text-field
                        v-model:value="imageUrl"
                        :label="$tc('splac.templateDetail.imageUrl')"
                        placeholder="https://example.com/product.jpg"
                    ></sw-text-field>
                    <sw-text-field
                        v-model:value="imageAlt"
                        :label="$tc('splac.templateDetail.imageAlt')"
                        :help-text="$tc('splac.templateDetail.imageAltHelp')"
                    ></sw-text-field>

                    <template #modal-footer>
                        <sw-button size="small" @click="closeImageEditor">
                            {{ $tc('global.default.cancel') }}
                        </sw-button>
                        <sw-button
                            variant="primary"
                            size="small"
                            :is-loading="isResolvingImage"
                            @click="insertImage"
                        >
                            {{ $tc('splac.templateDetail.insertImage') }}
                        </sw-button>
                    </template>
                </sw-modal>

                <sw-modal
                    v-if="tableFieldInstructionTarget"
                    :title="$tc('splac.templateDetail.tableFieldInstructionTitle')"
                    @modal-close="closeTableFieldInstruction"
                >
                    <p class="splac-template-detail__hint">
                        {{ $tc('splac.templateDetail.tableFieldInstructionHelp') }}
                    </p>
                    <sw-textarea-field
                        v-model="tableFieldInstructionDraft"
                        :label="$tc('splac.templateDetail.tableFieldInstructionLabel')"
                        :placeholder="$tc('splac.templateDetail.tableFieldInstructionPlaceholder')"
                    ></sw-textarea-field>

                    <template #modal-footer>
                        <sw-button size="small" @click="closeTableFieldInstruction">
                            {{ $tc('global.default.cancel') }}
                        </sw-button>
                        <sw-button
                            variant="primary"
                            size="small"
                            @click="saveTableFieldInstruction"
                        >
                            {{ $tc('global.default.save') }}
                        </sw-button>
                    </template>
                </sw-modal>
            </sw-card>

            <sw-card
                position-identifier="splac-template-detail-seo"
                :title="$tc('splac.templateDetail.cardSeo')"
                :is-loading="isLoading"
            >
                <div
                    v-for="field in ['metaTitle', 'metaDescription']"
                    :key="field"
                    class="splac-template-detail__seo-field"
                >
                    <h4>{{ $tc(`splac.templateDetail.seoField.${field}`) }}</h4>

                    <sw-select-field
                        v-model="item.config.fieldModes[field].mode"
                        :label="$tc('splac.templateDetail.fieldMode')"
                        :options="modeOptions"
                    ></sw-select-field>

                    <sw-textarea-field
                        v-for="locale in locales"
                        :key="`${field}-${locale}`"
                        v-model="item.config.fieldModes[field][locale]"
                        :label="`${$tc(item.config.fieldModes[field].mode === 'placeholder'
                            ? 'splac.templateDetail.fieldTextWithPlaceholders'
                            : 'splac.templateDetail.fieldInstruction')} (${locale})`"
                        :placeholder="item.config.fieldModes[field].mode === 'placeholder'
                            ? $tc('splac.templateDetail.placeholderModeExample')
                            : $tc('splac.templateDetail.instructionModeExample')"
                    ></sw-textarea-field>
                </div>
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

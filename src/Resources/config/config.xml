<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>LLM Provider</title>
        <title lang="de-DE">LLM-Anbieter</title>

        <input-field type="single-select">
            <name>provider</name>
            <label>Active provider</label>
            <label lang="de-DE">Aktiver Anbieter</label>
            <defaultValue>openai</defaultValue>
            <options>
                <option>
                    <id>openai</id>
                    <name>OpenAI</name>
                </option>
                <option>
                    <id>anthropic</id>
                    <name>Anthropic</name>
                </option>
                <option>
                    <id>gemini</id>
                    <name>Google Gemini</name>
                </option>
                <option>
                    <id>mistral</id>
                    <name>Mistral</name>
                </option>
            </options>
        </input-field>
    </card>

    <card>
        <title>PDF extraction</title>
        <title lang="de-DE">PDF-Extraktion</title>

        <input-field type="single-select">
            <name>pdfExtractionMode</name>
            <label>OCR mode</label>
            <label lang="de-DE">OCR-Modus</label>
            <defaultValue>automatic</defaultValue>
            <options>
                <option>
                    <id>automatic</id>
                    <name>Provider OCR with local fallback</name>
                    <name lang="de-DE">Anbieter-OCR mit lokalem Fallback</name>
                </option>
                <option>
                    <id>provider</id>
                    <name>Provider OCR only</name>
                    <name lang="de-DE">Nur Anbieter-OCR</name>
                </option>
                <option>
                    <id>local</id>
                    <name>Local extraction only</name>
                    <name lang="de-DE">Nur lokale Extraktion</name>
                </option>
            </options>
        </input-field>
    </card>

    <card>
        <title>Usage costs</title>
        <title lang="de-DE">Nutzungskosten</title>

        <input-field type="float">
            <name>inputTokenCost</name>
            <label>Input token cost per 1 million</label>
            <label lang="de-DE">Kosten pro 1 Million Eingabe-Token</label>
            <defaultValue>0</defaultValue>
        </input-field>

        <input-field type="float">
            <name>outputTokenCost</name>
            <label>Output token cost per 1 million</label>
            <label lang="de-DE">Kosten pro 1 Million Ausgabe-Token</label>
            <defaultValue>0</defaultValue>
        </input-field>

        <input-field type="float">
            <name>ocrPageCost</name>
            <label>OCR cost per page (Mistral)</label>
            <label lang="de-DE">OCR-Kosten pro Seite (Mistral)</label>
            <defaultValue>0</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>costCurrency</name>
            <label>Cost currency</label>
            <label lang="de-DE">Kostenwährung</label>
            <defaultValue>EUR</defaultValue>
            <options>
                <option>
                    <id>EUR</id>
                    <name>EUR (€)</name>
                </option>
                <option>
                    <id>USD</id>
                    <name>USD ($)</name>
                </option>
                <option>
                    <id>GBP</id>
                    <name>GBP (£)</name>
                </option>
            </options>
        </input-field>
    </card>

    <card>
        <title>OpenAI</title>

        <input-field type="password">
            <name>openaiApiKey</name>
            <label>API key</label>
            <label lang="de-DE">API-Schlüssel</label>
        </input-field>

        <input-field>
            <name>openaiModel</name>
            <label>Model</label>
            <label lang="de-DE">Modell</label>
            <defaultValue>gpt-4o</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Anthropic</title>

        <input-field type="password">
            <name>anthropicApiKey</name>
            <label>API key</label>
            <label lang="de-DE">API-Schlüssel</label>
        </input-field>

        <input-field>
            <name>anthropicModel</name>
            <label>Model</label>
            <label lang="de-DE">Modell</label>
            <defaultValue>claude-sonnet-4-5</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Google Gemini</title>

        <input-field type="password">
            <name>geminiApiKey</name>
            <label>API key</label>
            <label lang="de-DE">API-Schlüssel</label>
        </input-field>

        <input-field>
            <name>geminiModel</name>
            <label>Model</label>
            <label lang="de-DE">Modell</label>
            <defaultValue>gemini-flash-latest</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Mistral</title>

        <input-field type="password">
            <name>mistralApiKey</name>
            <label>API key</label>
            <label lang="de-DE">API-Schlüssel</label>
        </input-field>

        <input-field>
            <name>mistralModel</name>
            <label>Model</label>
            <label lang="de-DE">Modell</label>
            <defaultValue>mistral-large-latest</defaultValue>
        </input-field>
    </card>
</config>

<sw-page class="splac-template-list">
    <template #smart-bar-header>
        <h2>{{ $tc('splac.templates.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <input
            ref="templateFileInput"
            class="splac-template-list__file-input"
            type="file"
            accept=".json,application/json"
            @change="onImportFileSelected"
        >
        <sw-button
            variant="ghost"
            size="small"
            :disabled="isImporting"
            @click="openImportFilePicker"
        >
            {{ $tc('splac.templates.importTemplate') }}
        </sw-button>
        <sw-button
            variant="ghost"
            size="small"
            @click="$router.push({ name: 'splac.categoryTemplateDetail' })"
        >
            {{ $tc('splac.templates.addCategoryTemplate') }}
        </sw-button>
        <sw-button
            variant="primary"
            size="small"
            @click="$router.push({ name: 'splac.templateDetail' })"
        >
            {{ $tc('splac.templates.addTemplate') }}
        </sw-button>
    </template>

    <template #content>
        <sw-card-view>
            <section class="splac-template-list__overview">
                <div class="splac-template-list__overview-copy">
                    <h2>{{ $tc('splac.templates.overviewTitle') }}</h2>
                </div>
                <div class="splac-template-list__overview-metrics">
                    <div class="splac-template-list__overview-metric">
                        <span class="splac-template-list__metric-icon" aria-hidden="true">L</span>
                        <div>
                            <strong>{{ templates ? templates.length : 0 }}</strong>
                            <span>{{ $tc('splac.templates.listingCountLabel') }}</span>
                        </div>
                    </div>
                    <div class="splac-template-list__overview-metric">
                        <span class="splac-template-list__metric-icon splac-template-list__metric-icon--category" aria-hidden="true">C</span>
                        <div>
                            <strong>{{ categoryTemplates ? categoryTemplates.length : 0 }}</strong>
                            <span>{{ $tc('splac.templates.categoryCountLabel') }}</span>
                        </div>
                    </div>
                </div>
            </section>

            <sw-card
                class="splac-template-list__templates"
                position-identifier="splac-template-list-templates"
                :title="$tc('splac.templates.listingTemplatesTitle')"
                :is-loading="isLoading"
            >
                <template v-if="templates && templates.length">
                    <sw-data-grid
                        :data-source="templates"
                        :columns="templateColumns"
                        :show-selection="false"
                        :show-actions="true"
                        identifier="splac-template-grid"
                    >
                        <template #column-name="{ item }">
                            <router-link
                                class="splac-template-list__template-name"
                                :to="{ name: 'splac.templateDetail', params: { id: item.id } }"
                            >
                                <span class="splac-template-list__template-icon" aria-hidden="true">L</span>
                                <strong>{{ item.name }}</strong>
                            </router-link>
                        </template>
                        <template #column-active="{ item }">
                            <span
                                class="splac-template-list__status"
                                :class="{ 'is--active': item.active }"
                            >
                                <span aria-hidden="true"></span>
                                {{
                                    item.active
                                        ? $tc('splac.templates.statusActive')
                                        : $tc('splac.templates.statusInactive')
                                }}
                            </span>
                        </template>
                        <template #actions="{ item }">
                            <sw-context-menu-item @click="$router.push({ name: 'splac.templateDetail', params: { id: item.id } })">
                                {{ $tc('global.default.edit') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item @click="exportTemplate(item, 'listing')">
                                {{ $tc('splac.templates.exportTemplate') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item variant="danger" @click="onDeleteTemplate(item)">
                                {{ $tc('global.default.delete') }}
                            </sw-context-menu-item>
                        </template>
                    </sw-data-grid>
                </template>
                <sw-empty-state
                    v-else-if="!isLoading"
                    :title="$tc('splac.templates.emptyTitle')"
                    :subline="$tc('splac.templates.emptySubline')"
                    :absolute="false"
                >
                    <template #actions>
                        <sw-button
                            variant="primary"
                            size="small"
                            @click="$router.push({ name: 'splac.templateDetail' })"
                        >
                            {{ $tc('splac.templates.addTemplate') }}
                        </sw-button>
                    </template>
                </sw-empty-state>
            </sw-card>

            <sw-card
                class="splac-template-list__category-templates"
                position-identifier="splac-template-list-category-templates"
                :title="$tc('splac.templates.categoryTemplatesTitle')"
                :is-loading="isLoading"
            >
                <template v-if="categoryTemplates && categoryTemplates.length">
                    <sw-data-grid
                        :data-source="categoryTemplates"
                        :columns="categoryTemplateColumns"
                        :show-selection="false"
                        :show-actions="true"
                        identifier="splac-category-template-grid"
                    >
                        <template #column-name="{ item }">
                            <router-link
                                class="splac-template-list__template-name"
                                :to="{ name: 'splac.categoryTemplateDetail', params: { id: item.id } }"
                            >
                                <span class="splac-template-list__template-icon splac-template-list__template-icon--category" aria-hidden="true">C</span>
                                <strong>{{ item.name }}</strong>
                            </router-link>
                        </template>
                        <template #column-active="{ item }">
                            <span
                                class="splac-template-list__status"
                                :class="{ 'is--active': item.active }"
                            >
                                <span aria-hidden="true"></span>
                                {{
                                    item.active
                                        ? $tc('splac.templates.statusActive')
                                        : $tc('splac.templates.statusInactive')
                                }}
                            </span>
                        </template>
                        <template #actions="{ item }">
                            <sw-context-menu-item @click="$router.push({ name: 'splac.categoryTemplateDetail', params: { id: item.id } })">
                                {{ $tc('global.default.edit') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item @click="exportTemplate(item, 'category')">
                                {{ $tc('splac.templates.exportTemplate') }}
                            </sw-context-menu-item>
                            <sw-context-menu-item variant="danger" @click="onDeleteCategoryTemplate(item)">
                                {{ $tc('global.default.delete') }}
                            </sw-context-menu-item>
                        </template>
                    </sw-data-grid>
                </template>
                <sw-empty-state
                    v-else-if="!isLoading"
                    :title="$tc('splac.templates.emptyCategoryTitle')"
                    :subline="$tc('splac.templates.emptyCategorySubline')"
                    :absolute="false"
                >
                    <template #actions>
                        <sw-button
                            variant="primary"
                            size="small"
                            @click="$router.push({ name: 'splac.categoryTemplateDetail' })"
                        >
                            {{ $tc('splac.templates.addCategoryTemplate') }}
                        </sw-button>
                    </template>
                </sw-empty-state>
            </sw-card>
        </sw-card-view>

        <sw-modal
            v-if="pendingImport"
            class="splac-template-list__import-modal"
            :title="$tc('splac.templates.importModalTitle')"
            @modal-close="closeImportModal"
        >
            <div class="splac-template-list__import-summary">
                <span class="splac-template-list__import-type">
                    {{ pendingImportTypeLabel }}
                </span>
                <p>{{ $tc('splac.templates.importModalHelp') }}</p>
            </div>

            <sw-text-field
                v-model:value="pendingImport.template.name"
                :label="$tc('splac.templateDetail.fieldName')"
                :disabled="isImporting"
                :max-length="255"
                required
            ></sw-text-field>

            <sw-alert
                v-if="pendingImportHasDuplicateName"
                variant="warning"
                :closable="false"
            >
                {{ $tc('splac.templates.importDuplicateWarning') }}
            </sw-alert>

            <sw-alert
                v-if="pendingImport.type === 'category'"
                variant="info"
                :closable="false"
            >
                {{ $tc('splac.templates.importCategoryNotice') }}
            </sw-alert>

            <template #modal-footer>
                <sw-button
                    size="small"
                    :disabled="isImporting"
                    @click="closeImportModal"
                >
                    {{ $tc('global.default.cancel') }}
                </sw-button>
                <sw-button-process
                    variant="primary"
                    size="small"
                    :is-loading="isImporting"
                    :process-success="false"
                    :disabled="!isPendingImportNameValid"
                    @click="confirmImport"
                >
                    {{ $tc('splac.templates.importConfirm') }}
                </sw-button-process>
            </template>
        </sw-modal>
    </template>
</sw-page>

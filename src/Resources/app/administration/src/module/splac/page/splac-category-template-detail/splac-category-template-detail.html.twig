<sw-page class="splac-category-template-detail">
    <template #smart-bar-header>
        <h2>{{ item && item.name ? item.name : $tc('splac.categoryTemplateDetail.titleNew') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button size="small" @click="$router.push({ name: 'splac.templates' })">
            {{ $tc('global.default.cancel') }}
        </sw-button>
        <sw-button-process
            variant="primary"
            size="small"
            :is-loading="isSaving"
            :process-success="false"
            @click="onSave"
        >
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view v-if="item">
            <sw-card
                position-identifier="splac-category-template-general"
                :title="$tc('splac.categoryTemplateDetail.cardGeneral')"
                :is-loading="isLoading"
            >
                <div class="splac-category-template-detail__general-grid">
                    <sw-text-field
                        v-model:value="item.name"
                        :label="$tc('splac.templateDetail.fieldName')"
                        :placeholder="$tc('splac.categoryTemplateDetail.fieldNamePlaceholder')"
                        required
                    ></sw-text-field>

                    <sw-switch-field
                        v-model:value="item.active"
                        :label="$tc('splac.templateDetail.fieldActive')"
                    ></sw-switch-field>

                    <sw-entity-single-select
                        v-model:value="item.parentCategoryId"
                        entity="category"
                        :label="$tc('splac.categoryTemplateDetail.fieldParentCategory')"
                    ></sw-entity-single-select>
                </div>
            </sw-card>

            <sw-card
                position-identifier="splac-category-template-content"
                :title="$tc('splac.categoryTemplateDetail.cardContent')"
                :is-loading="isLoading"
            >
                <nav
                    class="splac-category-template-detail__locale-tabs"
                    :aria-label="$tc('splac.templateDetail.languageSwitcherLabel')"
                >
                    <button
                        v-for="locale in locales"
                        :key="`content-${locale}`"
                        type="button"
                        :class="{ 'is--active': activeLocale === locale }"
                        :aria-pressed="activeLocale === locale"
                        @click="activeLocale = locale"
                    >
                        <span>{{ localeLabel(locale) }}</span>
                        <small>{{ locale }}</small>
                    </button>
                </nav>

                <div class="splac-category-template-detail__field-list">
                <section
                    v-for="(field, fieldIndex) in contentFields"
                    :key="field"
                    class="splac-category-template-detail__field-section"
                >
                    <header class="splac-category-template-detail__field-header">
                        <span>{{ fieldIndex + 1 }}</span>
                        <div>
                            <h3>{{ $tc(`splac.categoryTemplateDetail.field.${field}`) }}</h3>
                        </div>
                    </header>

                    <div class="splac-category-template-detail__field-controls">
                        <sw-select-field
                            v-model="item.config[field].mode"
                            :label="$tc('splac.templateDetail.fieldMode')"
                            :options="modeOptions"
                        ></sw-select-field>

                        <sw-textarea-field
                            v-model="item.config[field][activeLocale]"
                            :label="`${$tc(item.config[field].mode === 'placeholder'
                                ? 'splac.templateDetail.fieldTextWithPlaceholders'
                                : 'splac.templateDetail.fieldInstruction')} · ${localeLabel(activeLocale)}`"
                        ></sw-textarea-field>
                    </div>
                </section>
                </div>
            </sw-card>

            <sw-card
                position-identifier="splac-category-template-seo"
                :title="$tc('splac.categoryTemplateDetail.cardSeo')"
                :is-loading="isLoading"
            >
                <nav
                    class="splac-category-template-detail__locale-tabs"
                    :aria-label="$tc('splac.templateDetail.languageSwitcherLabel')"
                >
                    <button
                        v-for="locale in locales"
                        :key="`seo-${locale}`"
                        type="button"
                        :class="{ 'is--active': activeLocale === locale }"
                        :aria-pressed="activeLocale === locale"
                        @click="activeLocale = locale"
                    >
                        <span>{{ localeLabel(locale) }}</span>
                        <small>{{ locale }}</small>
                    </button>
                </nav>

                <div class="splac-category-template-detail__field-list">
                <section
                    v-for="(field, fieldIndex) in seoFields"
                    :key="field"
                    class="splac-category-template-detail__field-section"
                >
                    <header class="splac-category-template-detail__field-header">
                        <span>{{ fieldIndex + 1 }}</span>
                        <div>
                            <h3>{{ $tc(`splac.categoryTemplateDetail.field.${field}`) }}</h3>
                        </div>
                    </header>

                    <div class="splac-category-template-detail__field-controls">
                        <sw-select-field
                            v-model="item.config[field].mode"
                            :label="$tc('splac.templateDetail.fieldMode')"
                            :options="modeOptions"
                        ></sw-select-field>

                        <sw-textarea-field
                            v-model="item.config[field][activeLocale]"
                            :label="`${$tc(item.config[field].mode === 'placeholder'
                                ? 'splac.templateDetail.fieldTextWithPlaceholders'
                                : 'splac.templateDetail.fieldInstruction')} · ${localeLabel(activeLocale)}`"
                        ></sw-textarea-field>
                    </div>
                </section>
                </div>
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

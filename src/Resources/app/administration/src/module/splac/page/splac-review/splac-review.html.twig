<sw-page class="splac-review">
    <template #smart-bar-header>
        <h2>{{ process ? process.name : '' }} – {{ $tc('splac.review.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button size="small" @click="$router.push({ name: 'splac.index' })">
            {{ $tc('splac.review.backToDashboard') }}
        </sw-button>
        <sw-button
            v-if="isDone"
            variant="ghost"
            size="small"
            @click="openProduct"
        >
            {{ $tc('splac.review.openProduct') }}
        </sw-button>
        <sw-button-process
            v-if="isReviewable"
            variant="primary"
            size="small"
            :is-loading="isApproving"
            :process-success="false"
            :disabled="isCategoryReviewInvalid"
            @click="onApprove"
        >
            {{ $tc('splac.review.approveButton') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view v-if="process">
            <!-- Generating banner -->
            <sw-alert v-if="isGenerating" variant="info" class="splac-review__banner">
                {{ $tc('splac.review.generatingBanner') }}
                <template v-if="process.currentStep"> ({{ $tc(`splac.steps.${process.currentStep}`) }})</template>
            </sw-alert>

            <sw-alert v-if="process.status === 'failed'" variant="error" class="splac-review__banner">
                {{ process.errorMessage }}
            </sw-alert>

            <sw-alert v-if="isReviewable && emptyFields.length" variant="warning" class="splac-review__banner">
                {{ $tc('splac.review.emptyFieldsWarning') }}: {{ emptyFields.join(', ') }}
            </sw-alert>

            <sw-alert
                v-if="isReviewable && isCategoryReviewInvalid"
                variant="error"
                class="splac-review__banner"
                :closable="false"
            >
                {{ $tc('splac.review.categoryApprovalBlocked') }}
            </sw-alert>

            <template v-if="isReviewable || isDone">
                <!-- Classification / identifiers -->
                <sw-card
                    position-identifier="splac-review-classification"
                    :title="$tc('splac.review.cardClassification')"
                    :is-loading="isLoading"
                >
                    <template #context-actions>
                        <sw-context-menu-item
                            :disabled="regeneratingStep !== null || isDone"
                            @click="onRegenerate('classification')"
                        >
                            {{ $tc('splac.review.regenerate') }}
                        </sw-context-menu-item>
                    </template>

                    <sw-container columns="1fr 1fr" gap="0 24px">
                        <template v-for="locale in locales" :key="`name-${locale}`">
                            <sw-text-field
                                v-if="output.productName"
                                v-model:value="output.productName[locale]"
                                :label="`${$tc('splac.review.fieldProductName')} (${locale})`"
                                :disabled="isDone"
                            ></sw-text-field>
                        </template>
                    </sw-container>

                    <sw-container columns="1fr 1fr 1fr" gap="0 24px">
                        <sw-text-field
                            v-if="'productNumber' in output"
                            v-model:value="output.productNumber"
                            :label="$tc('splac.review.fieldProductNumber')"
                            :disabled="isDone"
                        ></sw-text-field>
                        <sw-text-field
                            v-if="'ean' in output"
                            v-model:value="output.ean"
                            :label="$tc('splac.review.fieldEan')"
                            :disabled="isDone"
                        ></sw-text-field>
                        <sw-text-field
                            v-if="'manufacturerNumber' in output"
                            v-model:value="output.manufacturerNumber"
                            :label="$tc('splac.review.fieldManufacturerNumber')"
                            :disabled="isDone"
                        ></sw-text-field>
                    </sw-container>

                    <sw-container columns="1fr 1fr" gap="0 24px">
                        <sw-entity-single-select
                            v-if="'manufacturerId' in output"
                            v-model:value="output.manufacturerId"
                            entity="product_manufacturer"
                            :label="$tc('splac.review.fieldManufacturer')"
                            :help-text="$tc('splac.review.fieldManufacturerHelp')"
                            :disabled="isDone"
                        ></sw-entity-single-select>
                        <sw-text-field
                            v-if="'manufacturerName' in output"
                            v-model:value="output.manufacturerName"
                            :label="$tc('splac.review.fieldManufacturerName')"
                            :disabled="isDone"
                        ></sw-text-field>
                    </sw-container>

                    <sw-text-field
                        v-if="'tags' in output"
                        :value="tagList()"
                        :label="$tc('splac.review.fieldTags')"
                        :disabled="isDone"
                        @update:value="onTagsChange"
                    ></sw-text-field>
                </sw-card>

                <!-- Description -->
                <sw-card
                    v-if="output.description"
                    position-identifier="splac-review-description"
                    :title="$tc('splac.review.cardDescription')"
                    :is-loading="isLoading"
                >
                    <template #context-actions>
                        <sw-context-menu-item
                            :disabled="regeneratingStep !== null || isDone"
                            @click="onRegenerate('description')"
                        >
                            {{ $tc('splac.review.regenerate') }}
                        </sw-context-menu-item>
                    </template>

                    <div class="splac-review__locale-switch">
                        <sw-button
                            v-for="locale in locales"
                            :key="locale"
                            size="x-small"
                            :variant="previewLocale === locale ? 'primary' : null"
                            @click="previewLocale = locale"
                        >
                            {{ locale }}
                        </sw-button>
                    </div>

                    <div class="splac-review__description-split">
                        <sw-textarea-field
                            :key="previewLocale"
                            v-model="output.description[previewLocale]"
                            class="splac-review__description-editor"
                            :disabled="isDone"
                        ></sw-textarea-field>
                        <div class="splac-review__description-preview" v-html="output.description[previewLocale]"></div>
                    </div>
                </sw-card>

                <!-- SEO -->
                <sw-card
                    v-if="output.metaTitle || output.metaDescription"
                    position-identifier="splac-review-seo"
                    :title="$tc('splac.review.cardSeo')"
                    :is-loading="isLoading"
                >
                    <template #context-actions>
                        <sw-context-menu-item
                            :disabled="regeneratingStep !== null || isDone"
                            @click="onRegenerate('seo')"
                        >
                            {{ $tc('splac.review.regenerate') }}
                        </sw-context-menu-item>
                    </template>

                    <template v-for="locale in locales" :key="`seo-${locale}`">
                        <sw-text-field
                            v-if="output.metaTitle"
                            v-model:value="output.metaTitle[locale]"
                            :label="`${$tc('splac.review.fieldMetaTitle')} (${locale})`"
                            :disabled="isDone"
                        ></sw-text-field>
                        <sw-textarea-field
                            v-if="output.metaDescription"
                            v-model="output.metaDescription[locale]"
                            :label="`${$tc('splac.review.fieldMetaDescription')} (${locale})`"
                            :disabled="isDone"
                        ></sw-textarea-field>
                        <sw-text-field
                            v-if="output.keywords"
                            v-model:value="output.keywords[locale]"
                            :label="`${$tc('splac.review.fieldKeywords')} (${locale})`"
                            :disabled="isDone"
                        ></sw-text-field>
                    </template>
                </sw-card>

                <!-- Properties -->
                <sw-card
                    v-if="output.propertyOptionIds"
                    position-identifier="splac-review-properties"
                    :title="$tc('splac.review.cardProperties')"
                    :is-loading="isLoading"
                >
                    <template #context-actions>
                        <sw-context-menu-item
                            :disabled="regeneratingStep !== null || isDone"
                            @click="onRegenerate('properties')"
                        >
                            {{ $tc('splac.review.regenerate') }}
                        </sw-context-menu-item>
                    </template>

                    <sw-entity-multi-id-select
                        v-model:value="output.propertyOptionIds"
                        :repository="repositoryFactory.create('property_group_option')"
                        :label="$tc('splac.review.fieldProperties')"
                        :disabled="isDone"
                    ></sw-entity-multi-id-select>
                </sw-card>

                <!-- Generated category -->
                <sw-card
                    v-if="hasCategoryOutput && output.category"
                    class="splac-review__category-card"
                    position-identifier="splac-review-category"
                    :title="$tc('splac.review.cardCategory')"
                    :is-loading="isLoading"
                >
                    <template #context-actions>
                        <sw-context-menu-item
                            :disabled="regeneratingStep !== null || isDone"
                            @click="onRegenerate('category')"
                        >
                            {{ $tc('splac.review.regenerate') }}
                        </sw-context-menu-item>
                    </template>

                    <div class="splac-review__category-heading">
                        <div>
                            <span class="splac-review__category-eyebrow">
                                {{ isDone
                                    ? $tc('splac.review.categoryCreatedBadge')
                                    : $tc('splac.review.categoryNewBadge') }}
                            </span>
                            <h3>
                                {{ categoryReviewName || $tc('splac.review.categoryUntitled') }}
                            </h3>
                        </div>
                        <span
                            v-if="isCategoryReviewInvalid"
                            class="splac-review__category-attention"
                        >
                            {{ $tc('splac.review.categoryNeedsAttention') }}
                        </span>
                    </div>

                    <div class="splac-review__category-toolbar">
                        <div
                            v-if="locales.length > 1"
                            class="splac-review__locale-switch splac-review__locale-switch--category"
                        >
                            <sw-button
                                v-for="locale in locales"
                                :key="`category-locale-${locale}`"
                                size="x-small"
                                :variant="categoryReviewLocale === locale ? 'primary' : null"
                                @click="categoryReviewLocale = locale"
                            >
                                {{ locale }}
                            </sw-button>
                        </div>

                        <div
                            class="splac-review__category-tabs"
                            role="tablist"
                            :aria-label="$tc('splac.review.categoryReviewSections')"
                        >
                            <button
                                type="button"
                                role="tab"
                                :aria-selected="categoryReviewSection === 'content'"
                                :class="{ 'is--active': categoryReviewSection === 'content' }"
                                @click="categoryReviewSection = 'content'"
                            >
                                {{ $tc('splac.review.categoryContentTab') }}
                            </button>
                            <button
                                type="button"
                                role="tab"
                                :aria-selected="categoryReviewSection === 'seo'"
                                :class="{ 'is--active': categoryReviewSection === 'seo' }"
                                @click="categoryReviewSection = 'seo'"
                            >
                                {{ $tc('splac.review.categorySeoTab') }}
                            </button>
                        </div>
                    </div>

                    <sw-entity-single-select
                        v-if="'parentCategoryId' in output.category"
                        v-model:value="output.category.parentCategoryId"
                        entity="category"
                        :label="$tc('splac.review.fieldCategoryParent')"
                        :help-text="$tc('splac.review.fieldCategoryParentHelp')"
                        :disabled="isDone"
                    ></sw-entity-single-select>

                    <div
                        v-if="categoryReviewSection === 'content'"
                        class="splac-review__category-review-grid"
                        role="tabpanel"
                    >
                        <div class="splac-review__category-form">
                            <sw-text-field
                                v-if="output.category.name"
                                v-model:value="output.category.name[categoryReviewLocale]"
                                :label="`${$tc('splac.review.fieldCategoryName')} (${categoryReviewLocale})`"
                                :disabled="isDone"
                                required
                            ></sw-text-field>
                            <sw-textarea-field
                                v-if="output.category.description"
                                v-model="output.category.description[categoryReviewLocale]"
                                :label="`${$tc('splac.review.fieldCategoryDescription')} (${categoryReviewLocale})`"
                                :disabled="isDone"
                            ></sw-textarea-field>
                        </div>

                        <div class="splac-review__category-preview">
                            <div class="splac-review__preview-label">
                                {{ $tc('splac.review.categoryStorefrontPreview') }}
                            </div>
                            <article>
                                <span>{{ $tc('splac.review.categoryPreviewEyebrow') }}</span>
                                <h2>
                                    {{ categoryReviewName || $tc('splac.review.categoryUntitled') }}
                                </h2>
                                <div
                                    v-if="categoryReviewDescription"
                                    class="splac-review__category-description-preview"
                                    v-html="categoryReviewDescription"
                                ></div>
                            </article>
                        </div>
                    </div>

                    <div
                        v-else
                        class="splac-review__category-review-grid"
                        role="tabpanel"
                    >
                        <div class="splac-review__category-form">
                            <sw-text-field
                                v-if="output.category.metaTitle"
                                v-model:value="output.category.metaTitle[categoryReviewLocale]"
                                :label="`${$tc('splac.review.fieldCategoryMetaTitle')} (${categoryReviewLocale})`"
                                :disabled="isDone"
                                :max-length="60"
                            ></sw-text-field>
                            <div
                                v-if="output.category.metaTitle"
                                class="splac-review__character-count"
                                :class="characterCountClass(categoryReviewMetaTitle, 60)"
                            >
                                {{ categoryReviewMetaTitle.length }} / 60
                            </div>

                            <sw-textarea-field
                                v-if="output.category.metaDescription"
                                v-model="output.category.metaDescription[categoryReviewLocale]"
                                :label="`${$tc('splac.review.fieldCategoryMetaDescription')} (${categoryReviewLocale})`"
                                :disabled="isDone"
                                :max-length="160"
                            ></sw-textarea-field>
                            <div
                                v-if="output.category.metaDescription"
                                class="splac-review__character-count"
                                :class="characterCountClass(categoryReviewMetaDescription, 160)"
                            >
                                {{ categoryReviewMetaDescription.length }} / 160
                            </div>

                            <sw-text-field
                                v-if="output.category.keywords"
                                v-model:value="output.category.keywords[categoryReviewLocale]"
                                :label="`${$tc('splac.review.fieldCategoryKeywords')} (${categoryReviewLocale})`"
                                :help-text="$tc('splac.review.fieldCategoryKeywordsHelp')"
                                :disabled="isDone"
                            ></sw-text-field>

                            <div
                                v-if="categoryReviewKeywords.length"
                                class="splac-review__category-keywords"
                                :aria-label="$tc('splac.review.fieldCategoryKeywords')"
                            >
                                <span
                                    v-for="keyword in categoryReviewKeywords"
                                    :key="keyword"
                                >
                                    {{ keyword }}
                                </span>
                            </div>
                        </div>

                        <div class="splac-review__search-preview">
                            <div class="splac-review__preview-label">
                                {{ $tc('splac.review.categorySearchPreview') }}
                            </div>
                            <article>
                                <span class="splac-review__search-domain">
                                    {{ $tc('splac.review.categoryPreviewDomain') }}
                                </span>
                                <span class="splac-review__search-url">
                                    /{{ categoryReviewSlug }}
                                </span>
                                <h3>
                                    {{ categoryReviewMetaTitle
                                        || categoryReviewName
                                        || $tc('splac.review.categoryUntitled') }}
                                </h3>
                                <p v-if="categoryReviewMetaDescription">
                                    {{ categoryReviewMetaDescription }}
                                </p>
                            </article>
                        </div>
                    </div>

                    <div class="splac-review__category-footer">
                        <sw-help-text
                            :text="isDone
                                ? $tc('splac.review.categoryCreatedHelp')
                                : $tc('splac.review.categoryCreationHelp')"
                            :width="360"
                        ></sw-help-text>
                    </div>
                </sw-card>
            </template>

            <sw-card
                v-else-if="!isGenerating && process.status !== 'failed'"
                position-identifier="splac-review-empty"
            >
                <sw-empty-state
                    :title="$tc('splac.review.notReadyTitle')"
                    :absolute="false"
                ></sw-empty-state>
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>
